{
  "name": "@tryghost/kg-markdown-html-renderer",
  "version": "7.2.5",
  "description": "Markdown to HTML rendering for Ghost's markdown card",
  "license": "MIT",
  "author": "Ghost Foundation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TryGhost/Ghost.git",
    "directory": "koenig/kg-markdown-html-renderer"
  },
  "files": [
    "build"
  ],
  "main": "build/cjs/index.js",
  "module": "build/esm/index.js",
  "types": "build/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/esm/index.d.ts",
      "import": "./build/esm/index.js",
      "require": "./build/cjs/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tryghost/kg-utils": "~1.1.4",
    "markdown-it": "14.3.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-image-lazy-loading": "2.1.0",
    "markdown-it-lazy-headers": "0.1.3",
    "markdown-it-mark": "4.0.0",
    "markdown-it-sub": "2.0.0",
    "markdown-it-sup": "2.0.0",
    "semver": "7.8.5"
  },
  "engines": {
    "node": "^22.13.1 || ^24.0.0"
  },
  "scripts": {
    "dev": "echo \"Implement me!\"",
    "build": "tsc && tsc -p tsconfig.cjs.json && echo '{\"type\":\"module\"}' > build/esm/package.json",
    "test": "pnpm run '/^test:/'",
    "test:unit": "NODE_ENV=testing vitest run --coverage",
    "test:types": "tsc -p tsconfig.test.json",
    "lint": "eslint . --cache",
    "posttest": "pnpm lint"
  }
}
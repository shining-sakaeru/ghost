{
  "name": "@tryghost/kg-lexical-html-renderer",
  "version": "1.5.1",
  "description": "Renders serialized Lexical state to front-end or email HTML for Ghost",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TryGhost/Ghost.git",
    "directory": "koenig/kg-lexical-html-renderer"
  },
  "author": "Ghost Foundation",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "main": "build/cjs/index.js",
  "module": "build/esm/index.js",
  "types": "build/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/esm/index.d.ts",
      "import": "./build/esm/index.js",
      "require": "./build/cjs/index.js"
    }
  },
  "files": [
    "build",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@lexical/clipboard": "0.13.1",
    "@lexical/headless": "0.13.1",
    "@lexical/link": "0.13.1",
    "@lexical/list": "0.13.1",
    "@lexical/rich-text": "0.13.1",
    "@tryghost/kg-default-nodes": "~2.2.2",
    "@tryghost/kg-default-transforms": "~1.3.4",
    "@tryghost/kg-utils": "~1.1.4",
    "jsdom": "30.0.1",
    "lexical": "0.13.1"
  },
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput --sourceMap",
    "clean": "rm -rf build tsconfig.tsbuildinfo",
    "build": "pnpm clean && tsc && tsc -p tsconfig.cjs.json && echo '{\"type\":\"module\"}' > build/esm/package.json",
    "test": "pnpm run '/^test:/'",
    "test:unit": "NODE_ENV=testing vitest run --coverage",
    "test:types": "tsc --noEmit",
    "lint": "eslint",
    "posttest": "pnpm lint"
  }
}
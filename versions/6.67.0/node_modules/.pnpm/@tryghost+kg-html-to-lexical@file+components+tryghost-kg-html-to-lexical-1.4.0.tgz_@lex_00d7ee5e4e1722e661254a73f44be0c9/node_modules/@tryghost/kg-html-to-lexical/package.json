{
  "name": "@tryghost/kg-html-to-lexical",
  "version": "1.4.0",
  "description": "Converts HTML strings into Lexical editor state for Ghost",
  "license": "MIT",
  "author": "Ghost Foundation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TryGhost/Ghost.git",
    "directory": "koenig/kg-html-to-lexical"
  },
  "files": [
    "build",
    "LICENSE",
    "README.md"
  ],
  "main": "build/cjs/index.js",
  "module": "build/esm/index.js",
  "types": "build/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/esm/index.d.ts",
      "import": "./build/esm/index.js",
      "require": "./build/cjs/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@lexical/clipboard": "0.13.1",
    "@lexical/headless": "0.13.1",
    "@lexical/html": "0.13.1",
    "@lexical/link": "0.13.1",
    "@lexical/list": "0.13.1",
    "@lexical/rich-text": "0.13.1",
    "@tryghost/kg-default-nodes": "~2.2.2",
    "@tryghost/kg-default-transforms": "~1.3.4",
    "jsdom": "30.0.1",
    "lexical": "0.13.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput --sourceMap",
    "build": "tsc && tsc -p tsconfig.cjs.json && echo '{\"type\":\"module\"}' > build/esm/package.json",
    "test:unit": "NODE_ENV=testing vitest run --coverage",
    "test:types": "tsc --noEmit",
    "test": "pnpm run '/^test:/'",
    "lint": "eslint"
  }
}